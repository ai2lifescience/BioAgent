__pycache__/
*.py[cod]

.env
.env.*

# Runtime artifacts generated by local agent runs.
runtime/
chroma_db/
.snakemake/
data/ncbi_downloads*/
outputs/knowledge_reports/
/source/

# Local presentation and project-introduction exports.
docs/project_intro/

.venv/
.idea/
.vscode/

# External resources kept locally and excluded from version control.
/resource/

# Generated pipeline outputs belong in runtime workspaces.
**/output/

# Large sequencing and alignment files.
*.fastq
*.fastq.gz
*.fq
*.fq.gz
!tools/runtime_tools/pipelines/*/data/input/example_*.fastq
!tools/runtime_tools/pipelines/*/data/input/example_*.fastq.gz
!tools/runtime_tools/pipelines/*/data/input/example_*.fq
!tools/runtime_tools/pipelines/*/data/input/example_*.fq.gz
!tools/runtime_tools/pipelines/sequence_qc_demo/data/input/reads.fastq

# Pipeline bundles own their demonstration inputs; run outputs remain
# ignored and are written to session-scoped runtime directories.
!tools/runtime_tools/pipelines/**/data/
!tools/runtime_tools/pipelines/**/data/input/
!tools/runtime_tools/pipelines/**/data/input/**
tools/runtime_tools/pipelines/**/data/output/
*.bam
*.sam

# Python packaging and test artifacts.
*.egg-info/
.pytest_cache/

# Editor backup files.
*.bak
*.bak.*
