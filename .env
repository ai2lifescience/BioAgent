# Stable local BioAgent configuration. Export ports and all secrets manually
# before startup; explicit environment variables take precedence over this file.
BIOAGENT_BIND_HOST=127.0.0.1
BIOAGENT_PUBLIC_HOST=localhost
BIOAGENT_PUBLIC_SCHEME=http
OAUTH_PUBLIC_HOST=localhost
OAUTH_PUBLIC_SCHEME=http

AGENT_AUTH_MODE=oauth
AGENT_OAUTH_CLIENT_ID=bioagent
AGENT_OAUTH_PROXY=
AGENT_OAUTH_FLEXIBLE_HOST=true
AGENT_WEBSITE_LOGIN_TTL_SECONDS=120
AGENT_WEBSITE_CLIENTS_FILE=$PWD/runtime/website-integration/clients.json

CROMWELL_URL=http://192.168.164.46:39000
CROMWELL_INPUT_STORAGE_ENDPOINT=http://192.168.164.46:7070
CROMWELL_INPUT_STORAGE_URI=s3://cncb-web-server-mic/files
CROMWELL_INPUT_STORAGE_REGION=us-east-1
CROMWELL_INPUT_STORAGE_MOUNT_PREFIX=/data/versitygw/data/s3
CROMWELL_OUTPUT_STORAGE_URI=s3://cncb-web-server-mic/cromwell/outputs
CROMWELL_OUTPUT_STORAGE_MOUNT_PREFIX=/data/versitygw/data/s3/cncb-web-server-mic/cromwell/outputs
CROMWELL_OUTPUT_STORAGE_EXECUTION_PATH_PREFIXES=/data/zhaomh/cromwell-workspace/cromwell-executions,/cromwell-share/cloud_cromwell/cromwell-executions
