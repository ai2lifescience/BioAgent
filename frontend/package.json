{
  "name": "pipeline2agent-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:production",
    "build:development": "tsc -b && vite build --mode development && node ../web_bridge/frontend/build.mjs",
    "build:production": "tsc -b && vite build --mode production && node ../web_bridge/frontend/build.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "3dmol": "^2.5.5",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
